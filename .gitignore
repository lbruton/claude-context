# Dependencies (no trailing slash so a symlinked node_modules in a worktree is ignored too)
node_modules
*.pnp
.pnp.js

# Scratch dirs from .claude/hooks/test_post_edit_lint.py (removed after each run)
hooktest-scratch-*/

# Production builds
dist/
build/
*.tsbuildinfo

# Environment variables
.env
.env.local
.env.development.local
.env.production.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock



# IDE
# .vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary files
*.tmp
*.temp

# Extension specific
*.vsix
*.crx
*.pem

__pycache__/
*.log
!evaluation/case_study/**/*.log

# AI tools: config and instructions are tracked; only machine-local state is ignored
